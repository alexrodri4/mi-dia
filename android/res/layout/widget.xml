<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_widget_logo"/>
    <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:text="Mi Día" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/w_spent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAAEBB" android:textSize="12sp"/>
  </LinearLayout>
  <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
      android:textColor="#7FC4FF" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp"
      android:textColor="#E6E8EE" android:textSize="13.5sp" android:lineSpacingExtra="3dp" android:text="Abre la app para cargar tus tareas" android:ellipsize="end"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
    <TextView android:id="@+id/w_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center"
        android:background="@drawable/widget_btn" android:text="＋ Tarea" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
    <TextView android:id="@+id/w_voice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:layout_marginStart="8dp"
        android:background="@drawable/widget_btn" android:text="🎤 Voz" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
    <TextView android:id="@+id/w_ai" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:gravity="center" android:layout_marginStart="8dp"
        android:background="@drawable/widget_btn_ai" android:text="✦ Claude" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
  </LinearLayout>
</LinearLayout>
